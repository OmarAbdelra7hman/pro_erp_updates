<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Created="01/01/2024" ReportInfo.Modified="06/05/2026" ReportInfo.CreatorVersion="2024.1.0.0">
  <Dictionary>
    <BusinessObjectDataSource Name="Invoice" ReferenceName="Invoice" DataType="System.Collections.Generic.List`1[[System.Object]]" Enabled="true">
      <Column Name="InvoiceNumber" DataType="System.String"/>
      <Column Name="Date" DataType="System.DateTime"/>
      <Column Name="OperationTypeName" DataType="System.String"/>
      <Column Name="CustomerName" DataType="System.String"/>
      <Column Name="StoreName" DataType="System.String"/>
      <Column Name="SubTotal" DataType="System.Decimal"/>
      <Column Name="DiscountValue" DataType="System.Decimal"/>
      <Column Name="TaxTotal" DataType="System.Decimal"/>
      <Column Name="GrandTotal" DataType="System.Decimal"/>
      <Column Name="PaymentAmount" DataType="System.Decimal"/>
      <Column Name="Notes" DataType="System.String"/>
      <BusinessObjectDataSource Name="Lines" ReferenceName="Invoice.Lines" DataType="System.Collections.Generic.List`1[[System.Object]]" Enabled="true">
        <Column Name="ItemName" DataType="System.String"/>
        <Column Name="UnitName" DataType="System.String"/>
        <Column Name="Quantity" DataType="System.Decimal"/>
        <Column Name="UnitPrice" DataType="System.Decimal"/>
        <Column Name="LineTotal" DataType="System.Decimal"/>
      </BusinessObjectDataSource>
    </BusinessObjectDataSource>
    <Parameter Name="CompanyName" DataType="System.String"/>
    <Parameter Name="TaxNumber" DataType="System.String"/>
    <Parameter Name="ContactInfo" DataType="System.String"/>
    <Parameter Name="ReportTitle" DataType="System.String"/>
    <Parameter Name="PrintedBy" DataType="System.String"/>
    <Parameter Name="BarcodeText" DataType="System.String"/>
    <Parameter Name="PosReceiptText" DataType="System.String"/>
    <Parameter Name="PaymentInfo" DataType="System.String"/>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="78" PaperHeight="297" LeftMargin="4" TopMargin="4" RightMargin="4" BottomMargin="4" UnlimitedHeight="true" UnlimitedWidth="false">
    <ReportTitleBand Name="ReportTitle1" Width="264.6" Height="130">
      <PictureObject Name="Logo" Left="77" Top="5" Width="110" Height="50" SizeMode="Zoom"/>
      <TextObject Name="lblComp" Left="0" Top="58" Width="264.6" Height="20" Text="[CompanyName]" HorzAlign="Center" Font="Arial, 14pt, style=Bold"/>
      <TextObject Name="lblContact" Left="0" Top="80" Width="264.6" Height="14" Text="[ContactInfo]" HorzAlign="Center" Font="Arial, 8pt" RightToLeft="true" TextColor="DimGray"/>
      <TextObject Name="lblTax" Left="0" Top="94" Width="264.6" Height="14" Text="الرقم الضريبي: [TaxNumber]" HorzAlign="Center" Font="Arial, 8pt" RightToLeft="true" TextColor="DimGray"/>
      <TextObject Name="lblTitle" Left="0" Top="112" Width="264.6" Height="18" Text="[ReportTitle]" HorzAlign="Center" VertAlign="Center" Font="Arial, 11pt, style=Bold"/>
    </ReportTitleBand>
    <DataBand Name="DataInvoice" Top="132" Width="264.6" Height="55">
      <LineObject Name="Line1" Left="0" Top="0" Width="264.6" Height="0" Border.Width="0.5" Border.Color="Silver"/>
      <TextObject Name="lblInv" Left="130" Top="6" Width="134.6" Height="15" Text="[Invoice.InvoiceNumber]" Font="Arial, 9pt, style=Bold" HorzAlign="Right" RightToLeft="true"/>
      <TextObject Name="lblDate" Left="0" Top="6" Width="130" Height="15" Text="[Invoice.Date]" Format="Custom" Format.Format="dd/MM/yyyy HH:mm" Font="Arial, 8pt" HorzAlign="Left" TextColor="Gray"/>
      <TextObject Name="lblCust" Left="0" Top="24" Width="264.6" Height="14" Text="[Invoice.CustomerName]" Font="Arial, 9pt" HorzAlign="Right" RightToLeft="true"/>
      <TextObject Name="lblBranch" Left="0" Top="40" Width="264.6" Height="14" Text="[Invoice.StoreName]" Font="Arial, 8pt" HorzAlign="Right" RightToLeft="true" TextColor="Gray"/>
    </DataBand>
    <GroupHeaderBand Name="GroupHeader1" Top="189" Width="264.6" Height="18" Condition="[Invoice.InvoiceNumber]">
      <LineObject Name="Line2" Left="0" Top="0" Width="264.6" Height="0" Border.Width="0.5" Border.Color="Silver"/>
      <TextObject Name="h1" Left="150" Top="4" Width="114.6" Height="14" Text="الصنف" Font="Arial, 8pt" HorzAlign="Right" RightToLeft="true" TextColor="Gray"/>
      <TextObject Name="h2" Left="100" Top="4" Width="50" Height="14" Text="الكمية" Font="Arial, 7pt" HorzAlign="Center" TextColor="Gray"/>
      <TextObject Name="h2b" Left="50" Top="4" Width="50" Height="14" Text="السعر" Font="Arial, 7pt" HorzAlign="Center" TextColor="Gray"/>
      <TextObject Name="h3" Left="0" Top="4" Width="50" Height="14" Text="المبلغ" Font="Arial, 7pt" HorzAlign="Center" TextColor="Gray"/>
      
      <DataBand Name="DataLines" Top="209" Width="264.6" Height="22" DataSource="Lines">
        <TextObject Name="d1" Left="150" Top="0" Width="114.6" Height="22" Text="[Invoice.Lines.ItemName]" Font="Arial, 8pt" HorzAlign="Right" VertAlign="Center" RightToLeft="true" WordWrap="false" Trimming="EllipsisCharacter"/>
        <TextObject Name="d2" Left="100" Top="0" Width="50" Height="22" Text="[Invoice.Lines.Quantity]" Format="Number" Format.UseLocale="true" Font="Arial, 7pt" HorzAlign="Center" VertAlign="Center" TextColor="DimGray"/>
        <TextObject Name="d2b" Left="50" Top="0" Width="50" Height="22" Text="[Invoice.Lines.UnitPrice]" Format="Number" Format.UseLocale="true" Font="Arial, 7pt" HorzAlign="Center" VertAlign="Center" TextColor="DimGray"/>
        <TextObject Name="d3" Left="0" Top="0" Width="50" Height="22" Text="[Invoice.Lines.LineTotal]" Format="Number" Format.UseLocale="true" Font="Arial, 8pt, style=Bold" HorzAlign="Center" VertAlign="Center"/>
      </DataBand>
      
      <GroupFooterBand Name="GroupFooter1" Top="233" Width="264.6" Height="260">
        <LineObject Name="Line3" Left="0" Top="5" Width="264.6" Height="0" Border.Width="0.5" Border.Color="Silver"/>
        
        <TextObject Name="f1" Left="100" Top="14" Width="164.6" Height="16" Text="المجموع" Font="Arial, 9pt" HorzAlign="Right" RightToLeft="true" TextColor="DimGray"/>
        <TextObject Name="v1" Left="0" Top="14" Width="100" Height="16" Text="[Invoice.SubTotal]" Format="Number" Format.UseLocale="true" Font="Arial, 9pt, style=Bold" HorzAlign="Left"/>
        
        <TextObject Name="f2" Left="100" Top="32" Width="164.6" Height="16" Text="الخصم" Font="Arial, 9pt" HorzAlign="Right" RightToLeft="true" TextColor="DimGray"/>
        <TextObject Name="v2" Left="0" Top="32" Width="100" Height="16" Text="[Invoice.DiscountValue]" Format="Number" Format.UseLocale="true" Font="Arial, 9pt, style=Bold" HorzAlign="Left"/>
        
        <LineObject Name="Line4" Left="20" Top="52" Width="224.6" Height="0" Border.Width="0.5" Border.Color="DimGray"/>
        
        <TextObject Name="f3" Left="100" Top="58" Width="164.6" Height="22" Text="الصافي المطلوب" Font="Arial, 11pt, style=Bold" HorzAlign="Right" RightToLeft="true"/>
        <TextObject Name="v3" Left="0" Top="56" Width="100" Height="24" Text="[Invoice.GrandTotal]" Format="Number" Format.UseLocale="true" Font="Arial, 14pt, style=Bold" HorzAlign="Left"/>
        
        <TextObject Name="lblPaymentInfo" Left="0" Top="84" Width="264.6" Height="16" Text="[PaymentInfo]" Font="Arial, 8pt, style=Bold" HorzAlign="Center" RightToLeft="true" VisibleExpression="[PaymentInfo] != &quot;&quot;"/>
        
        <LineObject Name="Line5" Left="0" Top="106" Width="264.6" Height="0" Border.Width="0.5" Border.Color="Silver"/>
        <TextObject Name="lblPrintedBy" Left="0" Top="112" Width="264.6" Height="14" Text="الكاشير: [PrintedBy]" Font="Arial, 8pt" HorzAlign="Center" RightToLeft="true" TextColor="Gray"/>
        
        <TextObject Name="lblPosReceiptText" Left="0" Top="130" Width="264.6" Height="16" Text="[PosReceiptText]" Font="Arial, 8pt" HorzAlign="Center" RightToLeft="true" VisibleExpression="[PosReceiptText] != &quot;&quot;"/>
        
        <TextObject Name="lblThanks" Left="0" Top="150" Width="264.6" Height="16" Text="شكراً لزيارتكم" Font="Arial, 10pt, style=Bold" HorzAlign="Center" RightToLeft="true"/>
        
        <BarcodeObject Name="BarcodeReturn" Left="7" Top="174" Width="250" Height="45" AutoSize="false" Text="[BarcodeText]" ShowText="true" Barcode="Code128" HorzAlign="Center"/>
      </GroupFooterBand>
    </GroupHeaderBand>
  </ReportPage>
</Report>
