<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Created="01/01/2024" ReportInfo.Modified="05/19/2026" ReportInfo.CreatorVersion="2024.1.0.0">
  <Dictionary>
    <BusinessObjectDataSource Name="ShiftReport" ReferenceName="ShiftReport" DataType="System.Collections.Generic.List`1[[System.Object]]" Enabled="true">
      <Column Name="ShiftId" DataType="System.Int32"/>
      <Column Name="UserName" DataType="System.String"/>
      <Column Name="BranchName" DataType="System.String"/>
      <Column Name="OpenedAt" DataType="System.DateTime"/>
      <Column Name="ClosedAt" DataType="System.DateTime"/>
      <Column Name="OpeningBalance" DataType="System.Decimal"/>
      <Column Name="TotalSalesRevenue" DataType="System.Decimal"/>
      <Column Name="TotalSalesPaid" DataType="System.Decimal"/>
      <Column Name="TotalSalesCredit" DataType="System.Decimal"/>
      <Column Name="TotalReturns" DataType="System.Decimal"/>
      <Column Name="TotalVouchersIn" DataType="System.Decimal"/>
      <Column Name="TotalVouchersOut" DataType="System.Decimal"/>
      <Column Name="ActualClosingCash" DataType="System.Decimal"/>
      <Column Name="CashDifference" DataType="System.Decimal"/>
    </BusinessObjectDataSource>
    <BusinessObjectDataSource Name="PaymentMethods" ReferenceName="PaymentMethods" DataType="System.Collections.Generic.List`1[[System.Object]]" Enabled="true">
      <Column Name="AccountName" DataType="System.String"/>
      <Column Name="Amount" DataType="System.Decimal"/>
    </BusinessObjectDataSource>
    <Parameter Name="CompanyName" DataType="System.String"/>
    <Parameter Name="TaxNumber" DataType="System.String"/>
    <Parameter Name="ContactInfo" DataType="System.String"/>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="78" PaperHeight="297" LeftMargin="2" TopMargin="2" RightMargin="2" BottomMargin="2" UnlimitedHeight="true" UnlimitedWidth="false">
    <ReportTitleBand Name="ReportTitle1" Width="279.68" Height="140">
      <PictureObject Name="Logo" Left="84.84" Top="5" Width="110" Height="50" SizeMode="Zoom"/>
      <TextObject Name="lblComp" Left="0" Top="60" Width="279.68" Height="20" Text="[CompanyName]" HorzAlign="Center" Font="Arial, 14pt, style=Bold"/>
      <TextObject Name="lblTax" Left="0" Top="82" Width="279.68" Height="15" Text="الرقم الضريبي: [TaxNumber]" HorzAlign="Center" Font="Arial, 9pt" RightToLeft="true"/>
      <TextObject Name="lblContact" Left="0" Top="99" Width="279.68" Height="15" Text="[ContactInfo]" HorzAlign="Center" Font="Arial, 9pt" RightToLeft="true"/>
      <TextObject Name="lblTitle" Left="0" Top="116" Width="279.68" Height="20" Text="-- تقرير إقفال وردية كاشير --" HorzAlign="Center" VertAlign="Center" Font="Arial, 12pt, style=Bold"/>
    </ReportTitleBand>
    
    <DataBand Name="DataShift" Top="142" Width="279.68" Height="230" DataSource="ShiftReport">
      <TextObject Name="t1" Left="140" Top="5" Width="139.68" Height="15" Text="رقم الوردية: [ShiftReport.ShiftId]" Font="Arial, 9pt, style=Bold" HorzAlign="Right" RightToLeft="true"/>
      <TextObject Name="t2" Left="0" Top="5" Width="140" Height="15" Text="المستخدم: [ShiftReport.UserName]" Font="Arial, 9pt, style=Bold" HorzAlign="Right" RightToLeft="true"/>
      <TextObject Name="t3" Left="140" Top="22" Width="139.68" Height="15" Text="من: [ShiftReport.OpenedAt]" Format="Date" Format.Format="dd/MM HH:mm" Font="Arial, 9pt" HorzAlign="Right" RightToLeft="true"/>
      <TextObject Name="t4" Left="0" Top="22" Width="140" Height="15" Text="إلى: [ShiftReport.ClosedAt]" Format="Date" Format.Format="dd/MM HH:mm" Font="Arial, 9pt" HorzAlign="Right" RightToLeft="true"/>
      
      <LineObject Name="LineS1" Left="0" Top="42" Width="279.68" Height="0" Border.Width="1" Border.Style="Dash"/>
      
      <TextObject Name="r1_lbl" Left="140" Top="48" Width="139.68" Height="15" Text="العهدة الافتتاحية:" Font="Arial, 9pt, style=Bold" HorzAlign="Right" RightToLeft="true"/>
      <TextObject Name="r1_val" Left="0" Top="48" Width="140" Height="15" Text="[ShiftReport.OpeningBalance]" Format="Number" Format.UseLocale="true" Font="Arial, 9pt" HorzAlign="Left"/>
      
      <TextObject Name="r2_lbl" Left="140" Top="65" Width="139.68" Height="15" Text="إجمالي المبيعات:" Font="Arial, 9pt, style=Bold" HorzAlign="Right" RightToLeft="true"/>
      <TextObject Name="r2_val" Left="0" Top="65" Width="140" Height="15" Text="[ShiftReport.TotalSalesRevenue]" Format="Number" Format.UseLocale="true" Font="Arial, 9pt" HorzAlign="Left"/>
      
      <TextObject Name="r3_lbl" Left="140" Top="82" Width="139.68" Height="15" Text="   نقدي / مسدد:" Font="Arial, 9pt" HorzAlign="Right" RightToLeft="true"/>
      <TextObject Name="r3_val" Left="0" Top="82" Width="140" Height="15" Text="[ShiftReport.TotalSalesPaid]" Format="Number" Format.UseLocale="true" Font="Arial, 9pt" HorzAlign="Left"/>
      
      <TextObject Name="r4_lbl" Left="140" Top="99" Width="139.68" Height="15" Text="   آجل (لم يسدد):" Font="Arial, 9pt" HorzAlign="Right" RightToLeft="true"/>
      <TextObject Name="r4_val" Left="0" Top="99" Width="140" Height="15" Text="[ShiftReport.TotalSalesCredit]" Format="Number" Format.UseLocale="true" Font="Arial, 9pt" HorzAlign="Left"/>

      <TextObject Name="r5_lbl" Left="140" Top="116" Width="139.68" Height="15" Text="إجمالي المرتجعات:" Font="Arial, 9pt, style=Bold" HorzAlign="Right" RightToLeft="true"/>
      <TextObject Name="r5_val" Left="0" Top="116" Width="140" Height="15" Text="[ShiftReport.TotalReturns]" Format="Number" Format.UseLocale="true" Font="Arial, 9pt" HorzAlign="Left"/>

      <TextObject Name="r6_lbl" Left="140" Top="133" Width="139.68" Height="15" Text="سندات قبض (وارد):" Font="Arial, 9pt" HorzAlign="Right" RightToLeft="true"/>
      <TextObject Name="r6_val" Left="0" Top="133" Width="140" Height="15" Text="[ShiftReport.TotalVouchersIn]" Format="Number" Format.UseLocale="true" Font="Arial, 9pt" HorzAlign="Left"/>

      <TextObject Name="r7_lbl" Left="140" Top="150" Width="139.68" Height="15" Text="سندات صرف (صادر):" Font="Arial, 9pt" HorzAlign="Right" RightToLeft="true"/>
      <TextObject Name="r7_val" Left="0" Top="150" Width="140" Height="15" Text="[ShiftReport.TotalVouchersOut]" Format="Number" Format.UseLocale="true" Font="Arial, 9pt" HorzAlign="Left"/>

      <LineObject Name="LineS2" Left="0" Top="170" Width="279.68" Height="0" Border.Width="1" Border.Style="Dash"/>

      <TextObject Name="r8_lbl" Left="140" Top="175" Width="139.68" Height="15" Text="الجرد الفعلي:" Font="Arial, 10pt, style=Bold" HorzAlign="Right" RightToLeft="true"/>
      <TextObject Name="r8_val" Left="0" Top="175" Width="140" Height="15" Text="[ShiftReport.ActualClosingCash]" Format="Number" Format.UseLocale="true" Font="Arial, 10pt, style=Bold" HorzAlign="Left"/>

      <TextObject Name="r9_lbl" Left="140" Top="195" Width="139.68" Height="15" Text="العجز / الزيادة:" Font="Arial, 10pt, style=Bold" HorzAlign="Right" RightToLeft="true"/>
      <TextObject Name="r9_val" Left="0" Top="195" Width="140" Height="15" Text="[ShiftReport.CashDifference]" Format="Number" Format.UseLocale="true" Font="Arial, 10pt, style=Bold" HorzAlign="Left"/>
      
      <LineObject Name="LineS3" Left="0" Top="220" Width="279.68" Height="0" Border.Width="1"/>
    </DataBand>

    <DataBand Name="DataPaymentMethods" Top="420" Width="279.68" Height="20" DataSource="PaymentMethods">
      <DataHeaderBand Name="HeaderPM" Top="380" Width="279.68" Height="40">
        <TextObject Name="pm_title" Left="0" Top="5" Width="279.68" Height="20" Text="-- تفصيل المسدد حسب طرق الدفع --" HorzAlign="Center" VertAlign="Center" Font="Arial, 10pt, style=Bold"/>
        <TextObject Name="h_pm1" Left="140" Top="25" Width="139.68" Height="15" Text="طريقة الدفع (الحساب)" Font="Arial, 9pt, style=Bold" HorzAlign="Center" Border.Lines="Bottom" RightToLeft="true"/>
        <TextObject Name="h_pm2" Left="0" Top="25" Width="140" Height="15" Text="المبلغ" Font="Arial, 9pt, style=Bold" HorzAlign="Center" Border.Lines="Bottom"/>
      </DataHeaderBand>
      
      <TextObject Name="pm_name" Left="140" Top="2" Width="139.68" Height="15" Text="[PaymentMethods.AccountName]" Font="Arial, 9pt" HorzAlign="Center" RightToLeft="true"/>
      <TextObject Name="pm_amount" Left="0" Top="2" Width="140" Height="15" Text="[PaymentMethods.Amount]" Format="Number" Format.UseLocale="true" Font="Arial, 9pt" HorzAlign="Center"/>
      
      <DataFooterBand Name="FooterPM" Top="445" Width="279.68" Height="30">
        <TextObject Name="lblEnd" Left="0" Top="10" Width="279.68" Height="15" Text="*** نهاية التقرير ***" Font="Arial, 9pt" HorzAlign="Center" RightToLeft="true"/>
      </DataFooterBand>
    </DataBand>

  </ReportPage>
</Report>
