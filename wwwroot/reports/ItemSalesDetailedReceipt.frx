    <Parameter Name="CompanyName" DataType="System.String"/><Parameter Name="TaxNumber" DataType="System.String"/><Parameter Name="ContactInfo" DataType="System.String"/>
    <Parameter Name="ReportTitle" DataType="System.String"/><Parameter Name="Period" DataType="System.String"/><Parameter Name="PrintedBy" DataType="System.String"/>
    <Parameter Name="RowsCount" DataType="System.String"/><Parameter Name="SumQuantity" DataType="System.String"/><Parameter Name="SumValue" DataType="System.String"/>
    <Parameter Name="SumCost" DataType="System.String"/><Parameter Name="SumProfit" DataType="System.String"/>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="78" PaperHeight="297" LeftMargin="2" RightMargin="2" TopMargin="2" BottomMargin="2" UnlimitedHeight="true">
