      <Column Name="ItemName" DataType="System.String"/><Column Name="UnitName" DataType="System.String"/>
      <Column Name="Quantity" DataType="System.Decimal"/><Column Name="UnitPrice" DataType="System.Decimal"/>
      <Column Name="TotalValue" DataType="System.Decimal"/><Column Name="TotalCost" DataType="System.Decimal"/>
      <Column Name="Profit" DataType="System.Decimal"/>
