<?xml version="1.0" encoding="utf-8"?>
<Report DoublePass="true" ReportInfo.CreatorVersion="2026.1.8.0">
  <Dictionary>
    <BusinessObjectDataSource Name="Items" ReferenceName="Items" DataType="null" Enabled="true">
      <Column Name="Date" DataType="System.DateTime"/>
      <Column Name="InvoiceNumber" DataType="System.String"/>
      <Column Name="OperationTypeName" DataType="System.String"/>
      <Column Name="CustomerName" DataType="System.String"/>
      <Column Name="GrossTotal" DataType="System.Decimal"/>
      <Column Name="DiscountValue" DataType="System.Decimal"/>
      <Column Name="NetRevenue" DataType="System.Decimal"/>
      <Column Name="TotalCogs" DataType="System.Decimal"/>
      <Column Name="NetProfit" DataType="System.Decimal"/>
    </BusinessObjectDataSource>
    <Parameter Name="CompanyName" DataType="System.String"/>
    <Parameter Name="TaxNumber" DataType="System.String"/>
    <Parameter Name="ReportTitle" DataType="System.String"/>
    <Parameter Name="ContactInfo" DataType="System.String"/>
    <Parameter Name="DateFrom" DataType="System.String"/>
    <Parameter Name="DateTo" DataType="System.String"/>
    <Parameter Name="FiltersApplied" DataType="System.String"/>
    <Parameter Name="PrintedBy" DataType="System.String"/>
    <Parameter Name="Currency" DataType="System.String"/>
    <Parameter Name="RecordCount" DataType="System.Int32"/>
    <Parameter Name="ProfitTotal" DataType="System.Decimal"/>
    <Parameter Name="SumGross" DataType="System.String"/>
    <Parameter Name="SumDiscount" DataType="System.String"/>
    <Parameter Name="SumRevenue" DataType="System.String"/>
    <Parameter Name="SumCogs" DataType="System.String"/>
    <Parameter Name="SumProfit" DataType="System.String"/>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="210" PaperHeight="297" LeftMargin="10" RightMargin="10" TopMargin="10" BottomMargin="10" Watermark.Font="Arial, 60pt">
    <ReportTitleBand Name="ReportTitle1" Width="718.2" Height="182" CanGrow="true">
      <ShapeObject Name="TopAccent" Width="718.2" Height="3" Fill.Color="44, 65, 91" Border.Color="44, 65, 91"/>
      <PictureObject Name="Logo" Left="0" Top="17" Width="90" Height="58" SizeMode="Zoom"/>
      <TextObject Name="txtCompanyName" Left="114" Top="16" Width="604.2" Height="26" Text="[CompanyName]" Font="Arial, 14pt, style=Bold" HorzAlign="Right" VertAlign="Center" TextColor="30, 41, 59"/>
      <TextObject Name="txtTaxNumber" Left="114" Top="44" Width="604.2" Height="17" Text="الرقم الضريبي: [TaxNumber]" Font="Arial, 8.5pt" HorzAlign="Right" TextColor="100, 116, 139"/>
      <TextObject Name="txtContact" Left="114" Top="63" Width="604.2" Height="27" Text="[ContactInfo]" Font="Arial, 8pt" HorzAlign="Right" TextColor="100, 116, 139"/>
      <LineObject Name="HeaderRule" Top="98" Width="718.2" Border.Color="226, 232, 240"/>
      <TextObject Name="txtReportTitle" Top="109" Width="718.2" Height="29" Text="[ReportTitle]" Font="Arial, 17pt, style=Bold" HorzAlign="Center" VertAlign="Center" TextColor="30, 41, 59"/>
      <TextObject Name="txtReportMeta" Top="143" Width="718.2" Height="19" Text="عدد العمليات: [RecordCount]   |   العملة: [Currency]" Font="Arial, 8.5pt" HorzAlign="Center" VertAlign="Center" TextColor="100, 116, 139"/>
      <TextObject Name="txtFilters" Top="168" Width="718.2" Height="14" CanGrow="true" Text="[FiltersApplied]" Font="Arial, 8pt" HorzAlign="Right" TextColor="71, 85, 105"/>
      <ChildBand Name="Overview" Width="718.2" Height="96">
        <ShapeObject Name="RevenueCard" Left="486.8" Top="12" Width="231.4" Height="67" Fill.Color="242, 246, 250" Border.Color="242, 246, 250"/>
        <ShapeObject Name="CostCard" Left="243.4" Top="12" Width="231.4" Height="67" Fill.Color="242, 246, 250" Border.Color="242, 246, 250"/>
        <ShapeObject Name="ProfitCard" Top="12" Width="231.4" Height="67" Fill.Color="242, 246, 250" Border.Color="242, 246, 250"/>
        <TextObject Name="RevenueLabel" Left="498.8" Top="21" Width="207.4" Height="17" Text="صافي الإيرادات" Font="Arial, 9pt" HorzAlign="Right" TextColor="100, 116, 139"/>
        <TextObject Name="CostLabel" Left="255.4" Top="21" Width="207.4" Height="17" Text="تكلفة البضاعة" Font="Arial, 9pt" HorzAlign="Right" TextColor="100, 116, 139"/>
        <TextObject Name="ProfitLabel" Left="12" Top="21" Width="207.4" Height="17" Text="صافي الربح / الخسارة" Font="Arial, 9pt" HorzAlign="Right" TextColor="100, 116, 139"/>
        <TextObject Name="RevenueValue" Left="498.8" Top="44" Width="207.4" Height="24" Text="[SumRevenue]" Font="Arial, 15pt, style=Bold" HorzAlign="Right" TextColor="30, 41, 59"/>
        <TextObject Name="CostValue" Left="255.4" Top="44" Width="207.4" Height="24" Text="[SumCogs]" Font="Arial, 15pt, style=Bold" HorzAlign="Right" TextColor="30, 41, 59"/>
        <TextObject Name="ProfitValue" Left="12" Top="44" Width="207.4" Height="24" Text="[SumProfit]" Font="Arial, 15pt, style=Bold" HorzAlign="Right" TextColor="24, 112, 83">
          <Highlight><Condition Expression="[ProfitTotal] &lt; 0" TextFill.Color="174, 48, 62" ApplyTextFill="true"/></Highlight>
        </TextObject>
      </ChildBand>
    </ReportTitleBand>
    <DataBand Name="Data1" Width="718.2" Height="29" DataSource="Items" EvenStyle="EvenRow" CanGrow="true">
    <DataHeaderBand Name="TableHeader" Width="718.2" Height="32" RepeatOnEveryPage="true" KeepWithData="true" Fill.Color="44, 65, 91">
      <TextObject Name="hDate" Left="638.2" Width="80" Height="32" Text="التاريخ" HorzAlign="Center" VertAlign="Center" Font="Arial, 9pt, style=Bold" TextColor="White"/>
      <TextObject Name="hInvoice" Left="534.2" Width="104" Height="32" Text="رقم الفاتورة" HorzAlign="Center" VertAlign="Center" Font="Arial, 9pt, style=Bold" TextColor="White"/>
      <TextObject Name="hOpType" Left="442.2" Width="92" Height="32" Text="نوع العملية" HorzAlign="Center" VertAlign="Center" Font="Arial, 9pt, style=Bold" TextColor="White"/>
      <TextObject Name="hCustomer" Left="294" Width="148.2" Height="32" Text="العميل" HorzAlign="Right" Padding="6, 0, 8, 0" VertAlign="Center" Font="Arial, 9pt, style=Bold" TextColor="White"/>
      <TextObject Name="hNetRev" Left="196" Width="98" Height="32" Text="صافي الإيرادات" HorzAlign="Right" Padding="6, 0, 8, 0" VertAlign="Center" Font="Arial, 9pt, style=Bold" TextColor="White"/>
      <TextObject Name="hCogs" Left="98" Width="98" Height="32" Text="التكلفة" HorzAlign="Right" Padding="6, 0, 8, 0" VertAlign="Center" Font="Arial, 9pt, style=Bold" TextColor="White"/>
      <TextObject Name="hNetProfit" Width="98" Height="32" Text="صافي الربح" HorzAlign="Right" Padding="6, 0, 8, 0" VertAlign="Center" Font="Arial, 9pt, style=Bold" TextColor="White"/>
    </DataHeaderBand>
      <TextObject Name="ValDate" Left="638.2" Width="80" Height="29" Text="[Items.Date]" Format="Date" Format.Format="yyyy-MM-dd" HorzAlign="Center" VertAlign="Center" Font="Arial, 8pt" TextColor="71, 85, 105" Border.Lines="Bottom" Border.Color="230, 235, 241"/>
      <TextObject Name="ValInvoice" Left="534.2" Width="104" Height="29" Text="[Items.InvoiceNumber]" WordWrap="false" HorzAlign="Center" VertAlign="Center" Font="Arial, 8pt" TextColor="51, 65, 85" Border.Lines="Bottom" Border.Color="230, 235, 241"/>
      <TextObject Name="ValOpType" Left="442.2" Width="92" Height="29" Text="[Items.OperationTypeName]" CanGrow="true" HorzAlign="Center" VertAlign="Center" Font="Arial, 8.5pt" TextColor="71, 85, 105" Border.Lines="Bottom" Border.Color="230, 235, 241"/>
      <TextObject Name="ValCust" Left="294" Width="148.2" Height="29" Text="[Items.CustomerName]" CanGrow="true" HorzAlign="Right" Padding="6, 0, 8, 0" VertAlign="Center" Font="Arial, 9pt" TextColor="30, 41, 59" Border.Lines="Bottom" Border.Color="230, 235, 241"/>
      <TextObject Name="ValNetRev" Left="196" Width="98" Height="29" Text="[Items.NetRevenue]" Format="Number" Format.UseLocale="false" Format.DecimalDigits="2" Format.DecimalSeparator="." Format.GroupSeparator="," Format.NegativePattern="1" HorzAlign="Right" Padding="6, 0, 8, 0" VertAlign="Center" Font="Arial, 9pt" TextColor="30, 41, 59" Border.Lines="Bottom" Border.Color="230, 235, 241"/>
      <TextObject Name="ValCogs" Left="98" Width="98" Height="29" Text="[Items.TotalCogs]" Format="Number" Format.UseLocale="false" Format.DecimalDigits="2" Format.DecimalSeparator="." Format.GroupSeparator="," Format.NegativePattern="1" HorzAlign="Right" Padding="6, 0, 8, 0" VertAlign="Center" Font="Arial, 9pt" TextColor="71, 85, 105" Border.Lines="Bottom" Border.Color="230, 235, 241"/>
      <TextObject Name="ValNetProf" Width="98" Height="29" Text="[Items.NetProfit]" Format="Number" Format.UseLocale="false" Format.DecimalDigits="2" Format.DecimalSeparator="." Format.GroupSeparator="," Format.NegativePattern="1" HorzAlign="Right" Padding="6, 0, 8, 0" VertAlign="Center" Font="Arial, 9pt, style=Bold" TextColor="24, 112, 83" Border.Lines="Bottom" Border.Color="230, 235, 241">
        <Highlight><Condition Expression="[Items.NetProfit] &lt; 0" TextFill.Color="174, 48, 62" ApplyTextFill="true"/></Highlight>
      </TextObject>
    </DataBand>
    <ReportSummaryBand Name="ReportSummary1" Width="718.2" Height="56" KeepWithData="true">
      <LineObject Name="TotalsRule" Top="2" Width="718.2" Border.Color="148, 163, 184"/>
      <TextObject Name="txtTotalsLabel" Left="294" Top="8" Width="424.2" Height="30" Text="الإجمالي النهائي" HorzAlign="Right" Padding="6, 0, 8, 0" VertAlign="Center" Font="Arial, 10pt, style=Bold" TextColor="30, 41, 59" Fill.Color="242, 246, 250"/>
      <TextObject Name="txtSumRev" Left="196" Top="8" Width="98" Height="30" Text="[SumRevenue]" HorzAlign="Right" Padding="6, 0, 8, 0" VertAlign="Center" Font="Arial, 9pt, style=Bold" TextColor="30, 41, 59" Fill.Color="242, 246, 250"/>
      <TextObject Name="txtSumCogs" Left="98" Top="8" Width="98" Height="30" Text="[SumCogs]" HorzAlign="Right" Padding="6, 0, 8, 0" VertAlign="Center" Font="Arial, 9pt, style=Bold" TextColor="30, 41, 59" Fill.Color="242, 246, 250"/>
      <TextObject Name="txtSumProf" Top="8" Width="98" Height="30" Text="[SumProfit]" HorzAlign="Right" Padding="6, 0, 8, 0" VertAlign="Center" Font="Arial, 9pt, style=Bold" TextColor="24, 112, 83" Fill.Color="242, 246, 250">
        <Highlight><Condition Expression="[ProfitTotal] &lt; 0" TextFill.Color="174, 48, 62" ApplyTextFill="true"/></Highlight>
      </TextObject>
    </ReportSummaryBand>
    <PageFooterBand Name="PageFooter1" Width="718.2" Height="34">
      <LineObject Name="FooterRule" Width="718.2" Border.Color="226, 232, 240"/>
      <TextObject Name="TextPageNo" Top="9" Width="180" Height="18" Text="صفحة [Page] من [TotalPages]" HorzAlign="Left" Font="Arial, 8pt" TextColor="100, 116, 139"/>
      <TextObject Name="txtPrintDate" Left="180" Top="9" Width="328.2" Height="18" Text="طباعة: [Date]" Format="Date" Format.Format="yyyy-MM-dd HH:mm" HorzAlign="Center" Font="Arial, 8pt" TextColor="100, 116, 139"/>
      <TextObject Name="txtPrintedBy" Left="508.2" Top="9" Width="210" Height="18" Text="بواسطة: [PrintedBy]" HorzAlign="Right" Font="Arial, 8pt" TextColor="100, 116, 139"/>
    </PageFooterBand>
  </ReportPage>
  <Styles><Style Name="EvenRow" Fill.Color="248, 250, 252"/></Styles>
</Report>
