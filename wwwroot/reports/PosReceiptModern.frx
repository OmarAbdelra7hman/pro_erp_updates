<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Created="01/01/2024" ReportInfo.Modified="06/05/2026" ReportInfo.CreatorVersion="2024.1.0.0">
  <Dictionary>
    <BusinessObjectDataSource Name="Invoice" ReferenceName="Invoice" DataType="System.Collections.Generic.List`1[[System.Object]]" Enabled="true">
      <Column Name="InvoiceNumber" DataType="System.String"/>
      <Column Name="Date" DataType="System.DateTime"/>
      <Column Name="OperationTypeName" DataType="System.String"/>
      <Column Name="CustomerName" DataType="System.String"/>
      <Column Name="StoreName" DataType="System.String"/>
      <Column Name="SubTotal" DataType="System.Decimal"/>
      <Column Name="DiscountValue" DataType="System.Decimal"/>
      <Column Name="TaxTotal" DataType="System.Decimal"/>
      <Column Name="GrandTotal" DataType="System.Decimal"/>
      <Column Name="PaymentAmount" DataType="System.Decimal"/>
      <Column Name="Notes" DataType="System.String"/>
      <BusinessObjectDataSource Name="Lines" ReferenceName="Invoice.Lines" DataType="System.Collections.Generic.List`1[[System.Object]]" Enabled="true">
        <Column Name="ItemName" DataType="System.String"/>
        <Column Name="UnitName" DataType="System.String"/>
        <Column Name="Quantity" DataType="System.Decimal"/>
        <Column Name="UnitPrice" DataType="System.Decimal"/>
        <Column Name="LineTotal" DataType="System.Decimal"/>
      </BusinessObjectDataSource>
    </BusinessObjectDataSource>
    <Parameter Name="CompanyName" DataType="System.String"/>
    <Parameter Name="TaxNumber" DataType="System.String"/>
    <Parameter Name="ContactInfo" DataType="System.String"/>
    <Parameter Name="ReportTitle" DataType="System.String"/>
    <Parameter Name="PrintedBy" DataType="System.String"/>
    <Parameter Name="BarcodeText" DataType="System.String"/>
    <Parameter Name="PosReceiptText" DataType="System.String"/>
    <Parameter Name="PaymentInfo" DataType="System.String"/>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="78" PaperHeight="297" LeftMargin="3" TopMargin="3" RightMargin="3" BottomMargin="3" UnlimitedHeight="true" UnlimitedWidth="false">
    <ReportTitleBand Name="ReportTitle1" Width="272.16" Height="130">
      <PictureObject Name="Logo" Left="81" Top="5" Width="110" Height="50" SizeMode="Zoom"/>
      <TextObject Name="lblComp" Left="0" Top="58" Width="272.16" Height="22" Text="[CompanyName]" HorzAlign="Center" Font="Arial, 16pt, style=Bold"/>
      <TextObject Name="lblContact" Left="0" Top="82" Width="272.16" Height="14" Text="[ContactInfo]" HorzAlign="Center" Font="Arial, 8pt" RightToLeft="true" TextColor="Gray"/>
      <TextObject Name="lblTax" Left="0" Top="96" Width="272.16" Height="14" Text="الرقم الضريبي: [TaxNumber]" HorzAlign="Center" Font="Arial, 8pt" RightToLeft="true" TextColor="Gray"/>
      <TextObject Name="lblTitle" Left="0" Top="112" Width="272.16" Height="18" Text="[ReportTitle]" HorzAlign="Center" VertAlign="Center" Font="Arial, 11pt, style=Bold"/>
    </ReportTitleBand>
    <DataBand Name="DataInvoice" Top="132" Width="272.16" Height="55">
      <TextObject Name="lblSep1" Left="0" Top="0" Width="272.16" Height="10" Text="· · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · ·" HorzAlign="Center" Font="Arial, 7pt" TextColor="Silver"/>
      <TextObject Name="lblInvDate" Left="0" Top="12" Width="272.16" Height="15" Text="[Invoice.InvoiceNumber]  |  [Invoice.Date]" Format="Custom" Format.Format="dd/MM/yyyy HH:mm" Font="Arial, 9pt, style=Bold" HorzAlign="Center"/>
      <TextObject Name="lblCust" Left="0" Top="28" Width="272.16" Height="14" Text="العميل: [Invoice.CustomerName]" Font="Arial, 8pt" HorzAlign="Right" RightToLeft="true"/>
      <TextObject Name="lblBranch" Left="0" Top="42" Width="272.16" Height="14" Text="[Invoice.StoreName]" Font="Arial, 8pt" HorzAlign="Right" RightToLeft="true" TextColor="Gray"/>
    </DataBand>
    <GroupHeaderBand Name="GroupHeader1" Top="189" Width="272.16" Height="22" Condition="[Invoice.InvoiceNumber]">
      <TextObject Name="lblSep2" Left="0" Top="0" Width="272.16" Height="10" Text="· · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · ·" HorzAlign="Center" Font="Arial, 7pt" TextColor="Silver"/>
      <TextObject Name="h1" Left="150" Top="10" Width="122.16" Height="14" Text="الصنف" Font="Arial, 8pt" HorzAlign="Right" RightToLeft="true" TextColor="Gray"/>
      <TextObject Name="h2" Left="100" Top="10" Width="50" Height="14" Text="الكمية" Font="Arial, 7pt" HorzAlign="Center" TextColor="Gray"/>
      <TextObject Name="h2b" Left="50" Top="10" Width="50" Height="14" Text="السعر" Font="Arial, 7pt" HorzAlign="Center" TextColor="Gray"/>
      <TextObject Name="h3" Left="0" Top="10" Width="50" Height="14" Text="الإجمالي" Font="Arial, 7pt" HorzAlign="Center" TextColor="Gray"/>
      
      <DataBand Name="DataLines" Top="213" Width="272.16" Height="20" DataSource="Lines">
        <TextObject Name="d1" Left="150" Top="0" Width="122.16" Height="20" Text="[Invoice.Lines.ItemName]" Font="Arial, 8pt, style=Bold" HorzAlign="Right" VertAlign="Center" RightToLeft="true" WordWrap="false" Trimming="EllipsisCharacter"/>
        <TextObject Name="d2" Left="100" Top="0" Width="50" Height="20" Text="[Invoice.Lines.Quantity]" Format="Number" Format.UseLocale="true" Font="Arial, 7pt" HorzAlign="Center" VertAlign="Center" TextColor="DimGray"/>
        <TextObject Name="d2b" Left="50" Top="0" Width="50" Height="20" Text="[Invoice.Lines.UnitPrice]" Format="Number" Format.UseLocale="true" Font="Arial, 7pt" HorzAlign="Center" VertAlign="Center" TextColor="DimGray"/>
        <TextObject Name="d3" Left="0" Top="0" Width="50" Height="20" Text="[Invoice.Lines.LineTotal]" Format="Number" Format.UseLocale="true" Font="Arial, 8pt, style=Bold" HorzAlign="Center" VertAlign="Center"/>
      </DataBand>
      
      <GroupFooterBand Name="GroupFooter1" Top="235" Width="272.16" Height="260">
        <TextObject Name="lblSep3" Left="0" Top="5" Width="272.16" Height="10" Text="· · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · ·" HorzAlign="Center" Font="Arial, 7pt" TextColor="Silver"/>
        
        <TextObject Name="f1" Left="100" Top="20" Width="172.16" Height="16" Text="المجموع:" Font="Arial, 9pt" HorzAlign="Right" RightToLeft="true" TextColor="DimGray"/>
        <TextObject Name="v1" Left="0" Top="20" Width="100" Height="16" Text="[Invoice.SubTotal]" Format="Number" Format.UseLocale="true" Font="Arial, 9pt" HorzAlign="Left"/>
        
        <TextObject Name="f2" Left="100" Top="38" Width="172.16" Height="16" Text="الخصم:" Font="Arial, 9pt" HorzAlign="Right" RightToLeft="true" TextColor="DimGray"/>
        <TextObject Name="v2" Left="0" Top="38" Width="100" Height="16" Text="[Invoice.DiscountValue]" Format="Number" Format.UseLocale="true" Font="Arial, 9pt" HorzAlign="Left"/>
        
        <LineObject Name="Line4" Left="30" Top="58" Width="212.16" Height="0" Border.Width="2" Border.Color="DimGray"/>
        
        <TextObject Name="f3" Left="100" Top="64" Width="172.16" Height="24" Text="الصافي المطلوب:" Font="Arial, 12pt, style=Bold" HorzAlign="Right" RightToLeft="true"/>
        <TextObject Name="v3" Left="0" Top="64" Width="100" Height="24" Text="[Invoice.GrandTotal]" Format="Number" Format.UseLocale="true" Font="Arial, 16pt, style=Bold" HorzAlign="Left"/>
        
        <TextObject Name="lblPaymentInfo" Left="0" Top="92" Width="272.16" Height="18" Text="[PaymentInfo]" Font="Arial, 9pt, style=Bold" HorzAlign="Center" RightToLeft="true" VisibleExpression="[PaymentInfo] != &quot;&quot;"/>
        
        <TextObject Name="lblSep4" Left="0" Top="114" Width="272.16" Height="10" Text="· · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · · ·" HorzAlign="Center" Font="Arial, 7pt" TextColor="Silver"/>
        <TextObject Name="lblPrintedBy" Left="0" Top="126" Width="272.16" Height="14" Text="الكاشير: [PrintedBy]" Font="Arial, 8pt" HorzAlign="Center" RightToLeft="true" TextColor="Gray"/>
        
        <TextObject Name="lblPosReceiptText" Left="0" Top="144" Width="272.16" Height="18" Text="[PosReceiptText]" Font="Arial, 9pt" HorzAlign="Center" RightToLeft="true" VisibleExpression="[PosReceiptText] != &quot;&quot;"/>
        
        <TextObject Name="lblThanks" Left="0" Top="166" Width="272.16" Height="16" Text="✦ شكراً لزيارتكم ✦" Font="Arial, 10pt, style=Bold" HorzAlign="Center" RightToLeft="true"/>
        
        <BarcodeObject Name="BarcodeReturn" Left="11" Top="190" Width="250" Height="45" AutoSize="false" Text="[BarcodeText]" ShowText="true" Barcode="Code128" HorzAlign="Center"/>
      </GroupFooterBand>
    </GroupHeaderBand>
  </ReportPage>
</Report>
