<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Created="08/04/2026" ReportInfo.Modified="08/04/2026" ReportInfo.CreatorVersion="2026.1.8.0">
  <Dictionary>
    <BusinessObjectDataSource Name="Items" ReferenceName="Items" DataType="System.Collections.Generic.List`1[[System.Object]]" Enabled="true">
      <Column Name="ItemId" DataType="System.Int32"/>
      <Column Name="ItemCode" DataType="System.String"/>
      <Column Name="ItemName" DataType="System.String"/>
      <Column Name="UnitName" DataType="System.String"/>
      <Column Name="Quantity" DataType="System.Decimal"/>
      <Column Name="UnitPrice" DataType="System.Decimal"/>
      <Column Name="TotalValue" DataType="System.Decimal"/>
    </BusinessObjectDataSource>
    <Parameter Name="CompanyName" DataType="System.String"/>
    <Parameter Name="TaxNumber" DataType="System.String"/>
    <Parameter Name="ContactInfo" DataType="System.String"/>
    <Parameter Name="ShiftId" DataType="System.String"/>
    <Parameter Name="UserName" DataType="System.String"/>
    <Parameter Name="BranchName" DataType="System.String"/>
    <Parameter Name="OpenedAt" DataType="System.String"/>
    <Parameter Name="ClosedAt" DataType="System.String"/>
    <Parameter Name="ItemsCount" DataType="System.String"/>
    <Parameter Name="GrandTotal" DataType="System.String"/>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="78" PaperHeight="297" LeftMargin="2" TopMargin="2" RightMargin="2" BottomMargin="2" UnlimitedHeight="true" UnlimitedWidth="false">
    <ReportTitleBand Name="ReportTitle1" Width="279.68" Height="188">
      <PictureObject Name="Logo" Left="99.84" Top="4" Width="80" Height="42" SizeMode="Zoom"/>
      <TextObject Name="Company" Left="0" Top="49" Width="279.68" Height="20" Text="[CompanyName]" HorzAlign="Center" Font="Arial, 13pt, style=Bold" RightToLeft="true"/>
      <TextObject Name="Tax" Left="0" Top="70" Width="279.68" Height="15" Text="الرقم الضريبي: [TaxNumber]" HorzAlign="Center" Font="Arial, 8pt" RightToLeft="true"/>
      <TextObject Name="Contact" Left="0" Top="86" Width="279.68" Height="15" Text="[ContactInfo]" HorzAlign="Center" Font="Arial, 8pt" RightToLeft="true"/>
      <TextObject Name="Title" Left="0" Top="104" Width="279.68" Height="22" Text="تفاصيل مبيعات الوردية" HorzAlign="Center" VertAlign="Center" Font="Arial, 12pt, style=Bold" RightToLeft="true"/>
      <LineObject Name="Line1" Left="0" Top="130" Width="279.68"/>
      <TextObject Name="Shift" Left="139.84" Top="135" Width="139.84" Height="15" Text="رقم الوردية: [ShiftId]" HorzAlign="Right" Font="Arial, 8pt, style=Bold" RightToLeft="true"/>
      <TextObject Name="Cashier" Left="0" Top="135" Width="139.84" Height="15" Text="الكاشير: [UserName]" HorzAlign="Right" Font="Arial, 8pt, style=Bold" RightToLeft="true"/>
      <TextObject Name="Branch" Left="0" Top="151" Width="279.68" Height="15" Text="الفرع: [BranchName]" HorzAlign="Right" Font="Arial, 8pt" RightToLeft="true"/>
      <TextObject Name="Period" Left="0" Top="167" Width="279.68" Height="15" Text="من [OpenedAt]  إلى [ClosedAt]" HorzAlign="Center" Font="Arial, 7pt" RightToLeft="true"/>
    </ReportTitleBand>
    <DataBand Name="ItemsData" Top="192" Width="279.68" Height="76" DataSource="Items" CanGrow="true" KeepTogether="true">
      <TextObject Name="Item" Left="0" Top="3" Width="279.68" Height="20" Text="[Items.ItemName]" HorzAlign="Right" Font="Arial, 10pt, style=Bold" RightToLeft="true" CanGrow="true"/>
      <TextObject Name="CodeUnit" Left="0" Top="26" Width="279.68" Height="16" Text="[Items.ItemCode] | [Items.UnitName]" HorzAlign="Right" Font="Arial, 8pt" RightToLeft="true" ShiftMode="Always"/>
      <TextObject Name="QtyPrice" Left="120" Top="46" Width="159.68" Height="20" Text="[FormatNumber([Items.Quantity], 2)] × [FormatNumber([Items.UnitPrice], 2)]" HorzAlign="Right" Font="Arial, 9pt" ShiftMode="Always"/>
      <TextObject Name="Value" Left="0" Top="46" Width="120" Height="20" Text="[Items.TotalValue]" Format="Number" Format.UseLocale="true" Format.DecimalDigits="2" HorzAlign="Left" Font="Arial, 10pt, style=Bold" ShiftMode="Always"/>
      <LineObject Name="ItemDivider" Left="0" Top="73" Width="279.68" Border.Style="Dot" ShiftMode="Always"/>
      <DataFooterBand Name="ItemsFooter" Top="247" Width="279.68" Height="66">
        <LineObject Name="Line2" Left="0" Top="4" Width="279.68"/>
        <TextObject Name="GrandTotalLabel" Left="120" Top="9" Width="159.68" Height="20" Text="إجمالي قيمة الأصناف" HorzAlign="Right" VertAlign="Center" Font="Arial, 10pt, style=Bold" RightToLeft="true"/>
        <TextObject Name="GrandTotalValue" Left="0" Top="9" Width="120" Height="20" Text="[GrandTotal]" HorzAlign="Center" VertAlign="Center" Border.Lines="All" Font="Arial, 10pt, style=Bold"/>
        <TextObject Name="Count" Left="0" Top="33" Width="279.68" Height="14" Text="عدد الصفوف المجمعة: [ItemsCount]" HorzAlign="Center" Font="Arial, 7pt, style=Bold" RightToLeft="true"/>
        <TextObject Name="NetNote" Left="0" Top="49" Width="279.68" Height="14" Text="الكميات والقيم صافية بعد خصم المرتجعات" HorzAlign="Center" Font="Arial, 7pt" RightToLeft="true"/>
      </DataFooterBand>
    </DataBand>
  </ReportPage>
</Report>
