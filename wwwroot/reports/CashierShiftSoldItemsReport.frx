    <Parameter Name="BranchName" DataType="System.String"/>
    <Parameter Name="OpenedAt" DataType="System.String"/>
    <Parameter Name="ClosedAt" DataType="System.String"/>
    <Parameter Name="ItemsCount" DataType="System.String"/>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="78" PaperHeight="297" LeftMargin="2" TopMargin="2" RightMargin="2" BottomMargin="2" UnlimitedHeight="true" UnlimitedWidth="false">
    <ReportTitleBand Name="ReportTitle1" Width="279.68" Height="188">
