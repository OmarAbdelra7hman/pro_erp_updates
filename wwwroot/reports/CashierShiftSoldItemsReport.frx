      <TextObject Name="Unit" Left="44.68" Width="50" Height="22" Text="[Items.UnitName]" HorzAlign="Center" VertAlign="Center" Border.Lines="All" Font="Arial, 7pt" RightToLeft="true" CanGrow="true"/>
