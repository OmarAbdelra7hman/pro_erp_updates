      <TextObject Name="Period" Left="0" Top="167" Width="279.68" Height="15" Text="من [OpenedAt]  إلى [ClosedAt]" HorzAlign="Center" Font="Arial, 7pt" RightToLeft="true"/>
    </ReportTitleBand>
    <DataBand Name="ItemsData" Top="221" Width="279.68" Height="22" DataSource="Items" CanGrow="true">
      <DataHeaderBand Name="ItemsHeader" Top="192" Width="279.68" Height="25" RepeatOnEveryPage="true">
        <TextObject Name="HCode" Left="219.68" Top="2" Width="60" Height="20" Text="الكود" HorzAlign="Center" VertAlign="Center" Border.Lines="All" Font="Arial, 8pt, style=Bold" RightToLeft="true"/>
