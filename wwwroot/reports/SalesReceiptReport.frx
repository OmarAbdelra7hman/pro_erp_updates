<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.CreatorVersion="2026.1.8.0">
  <Dictionary>
    <BusinessObjectDataSource Name="Items" ReferenceName="Items" DataType="System.Collections.Generic.List`1[[System.Object]]" Enabled="true">
      <Column Name="InvoiceNumber" DataType="System.String"/><Column Name="OperationTypeName" DataType="System.String"/>
      <Column Name="Date" DataType="System.DateTime"/><Column Name="CustomerName" DataType="System.String"/>
      <Column Name="GrossTotal" DataType="System.Decimal"/><Column Name="DiscountValue" DataType="System.Decimal"/>
      <Column Name="NetRevenue" DataType="System.Decimal"/><Column Name="TotalCogs" DataType="System.Decimal"/>
      <Column Name="NetProfit" DataType="System.Decimal"/>
    </BusinessObjectDataSource>
    <Parameter Name="CompanyName" DataType="System.String"/><Parameter Name="TaxNumber" DataType="System.String"/>
    <Parameter Name="ContactInfo" DataType="System.String"/><Parameter Name="ReportTitle" DataType="System.String"/>
    <Parameter Name="Period" DataType="System.String"/><Parameter Name="PrintedBy" DataType="System.String"/>
    <Parameter Name="RowsCount" DataType="System.String"/><Parameter Name="SumGross" DataType="System.String"/>
    <Parameter Name="SumDiscount" DataType="System.String"/><Parameter Name="SumRevenue" DataType="System.String"/>
    <Parameter Name="SumCogs" DataType="System.String"/><Parameter Name="SumProfit" DataType="System.String"/>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="78" PaperHeight="297" LeftMargin="2" RightMargin="2" TopMargin="2" BottomMargin="2" UnlimitedHeight="true">
