      <TextObject Name="Profit" Left="0" Top="29" Width="139.84" Height="14" Text="الربح: [Items.NetProfit]" Format="Number" Format.UseLocale="true" Format.DecimalDigits="2" Font="Arial, 8pt, style=Bold" HorzAlign="Left" RightToLeft="true"/>
      <DataFooterBand Name="Footer" Width="279.68" Height="126">
