<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Created="01/01/2024" ReportInfo.Modified="03/30/2026" ReportInfo.CreatorVersion="2024.1.0.0">
  <Dictionary>
    <BusinessObjectDataSource Name="Invoice" ReferenceName="Invoice" DataType="System.Collections.Generic.List`1[[System.Object]]" Enabled="true">
      <Column Name="InvoiceNumber" DataType="System.String"/>
      <Column Name="Date" DataType="System.DateTime"/>
      <Column Name="OperationTypeName" DataType="System.String"/>
      <Column Name="CustomerName" DataType="System.String"/>
      <Column Name="StoreName" DataType="System.String"/>
      <Column Name="SubTotal" DataType="System.Decimal"/>
      <Column Name="DiscountValue" DataType="System.Decimal"/>
      <Column Name="TaxTotal" DataType="System.Decimal"/>
      <Column Name="GrandTotal" DataType="System.Decimal"/>
      <Column Name="PaymentAmount" DataType="System.Decimal"/>
      <Column Name="Notes" DataType="System.String"/>
      <BusinessObjectDataSource Name="Lines" ReferenceName="Invoice.Lines" DataType="System.Collections.Generic.List`1[[System.Object]]" Enabled="true">
        <Column Name="ItemName" DataType="System.String"/>
        <Column Name="UnitName" DataType="System.String"/>
        <Column Name="Quantity" DataType="System.Decimal"/>
        <Column Name="UnitPrice" DataType="System.Decimal"/>
        <Column Name="LineTotal" DataType="System.Decimal"/>
      </BusinessObjectDataSource>
    </BusinessObjectDataSource>
    <Parameter Name="CompanyName" DataType="System.String"/>
    <Parameter Name="TaxNumber" DataType="System.String"/>
    <Parameter Name="ContactInfo" DataType="System.String"/>
    <Parameter Name="ReportTitle" DataType="System.String"/>
    <Parameter Name="PrintedBy" DataType="System.String"/>
    <Parameter Name="BarcodeText" DataType="System.String"/>
  </Dictionary>
  <ReportPage Name="Page1" PaperWidth="78" PaperHeight="297" LeftMargin="2" TopMargin="2" RightMargin="2" BottomMargin="2" UnlimitedHeight="true" UnlimitedWidth="false">
    <ReportTitleBand Name="ReportTitle1" Width="279.68" Height="140">
      <PictureObject Name="Logo" Left="84.84" Top="5" Width="110" Height="50" SizeMode="Zoom"/>
      <TextObject Name="lblComp" Left="0" Top="60" Width="279.68" Height="20" Text="[CompanyName]" HorzAlign="Center" Font="Arial, 14pt, style=Bold"/>
      <TextObject Name="lblTax" Left="0" Top="82" Width="279.68" Height="15" Text="الرقم الضريبي: [TaxNumber]" HorzAlign="Center" Font="Arial, 9pt" RightToLeft="true"/>
      <TextObject Name="lblContact" Left="0" Top="99" Width="279.68" Height="15" Text="[ContactInfo]" HorzAlign="Center" Font="Arial, 9pt" RightToLeft="true"/>
      <TextObject Name="lblTitle" Left="0" Top="116" Width="279.68" Height="20" Text="-- [ReportTitle] --" HorzAlign="Center" VertAlign="Center" Font="Arial, 12pt, style=Bold"/>
    </ReportTitleBand>
    <DataBand Name="DataInvoice" Top="142" Width="279.68" Height="60">
      <TextObject Name="lblInv" Left="130" Top="5" Width="149.68" Height="15" Text="رقم الفاتورة: [Invoice.InvoiceNumber]" Font="Arial, 9pt, style=Bold" HorzAlign="Right" RightToLeft="true"/>
      <TextObject Name="lblDate" Left="0" Top="5" Width="130" Height="15" Text="[Invoice.Date]" Format="Custom" Format.Format="dd/MM/yyyy HH:mm" Font="Arial, 9pt" HorzAlign="Left"/>
      <TextObject Name="lblCust" Left="0" Top="22" Width="279.68" Height="15" Text="العميل: [Invoice.CustomerName]" Font="Arial, 9pt" HorzAlign="Right" RightToLeft="true"/>
      <TextObject Name="lblBranch" Left="0" Top="39" Width="279.68" Height="15" Text="الفرع/المخزن: [Invoice.StoreName]" Font="Arial, 9pt" HorzAlign="Right" RightToLeft="true"/>
      <LineObject Name="Line1" Left="0" Top="58" Width="279.68" Height="0" Border.Width="1" Border.Style="Dash"/>
    </DataBand>
    <GroupHeaderBand Name="GroupHeader1" Top="204" Width="279.68" Height="20" Condition="[Invoice.InvoiceNumber]">
      <TextObject Name="h1" Left="160" Top="0" Width="119.68" Height="20" Text="الصنف" Font="Arial, 9pt, style=Bold" HorzAlign="Center" VertAlign="Center" RightToLeft="true" Border.Lines="All"/>
      <TextObject Name="h2" Left="80" Top="0" Width="80" Height="20" Text="المقدار" Font="Arial, 9pt, style=Bold" HorzAlign="Center" VertAlign="Center" RightToLeft="true" Border.Lines="All"/>
      <TextObject Name="h3" Left="0" Top="0" Width="80" Height="20" Text="الإجمالي" Font="Arial, 9pt, style=Bold" HorzAlign="Center" VertAlign="Center" RightToLeft="true" Border.Lines="All"/>
      
      <DataBand Name="DataLines" Top="226" Width="279.68" Height="24" DataSource="Lines">
        <TextObject Name="d1" Left="160" Top="0" Width="119.68" Height="24" Text="[Invoice.Lines.ItemName]" Font="Arial, 8pt, style=Bold" HorzAlign="Center" VertAlign="Center" RightToLeft="true" WordWrap="false" Trimming="EllipsisCharacter" Border.Lines="All"/>
        <TextObject Name="d2" Left="80" Top="0" Width="80" Height="24" Text="[Invoice.Lines.Quantity]x[Invoice.Lines.UnitPrice]" Format="Number" Format.UseLocale="true" Font="Arial, 8pt" HorzAlign="Center" VertAlign="Center" Border.Lines="All" AutoShrink="FontSize"/>
        <TextObject Name="d3" Left="0" Top="0" Width="80" Height="24" Text="[Invoice.Lines.LineTotal]" Format="Number" Format.UseLocale="true" Font="Arial, 9pt, style=Bold" HorzAlign="Center" VertAlign="Center" Border.Lines="All"/>
      </DataBand>
      
      <GroupFooterBand Name="GroupFooter1" Top="252" Width="279.68" Height="190">
        <!-- Spacer between table and totals -->
        <LineObject Name="Line3" Left="0" Top="5" Width="279.68" Height="0" Border.Width="1" Border.Style="Dash"/>
        
        <TextObject Name="f1" Left="110" Top="15" Width="169.68" Height="18" Text="المجموع الإجمالي:" Font="Arial, 10pt, style=Bold" HorzAlign="Right" RightToLeft="true"/>
        <TextObject Name="v1" Left="0" Top="15" Width="110" Height="18" Text="[Invoice.SubTotal]" Format="Number" Format.UseLocale="true" Font="Arial, 10pt, style=Bold" HorzAlign="Left"/>
        
        <TextObject Name="f2" Left="110" Top="35" Width="169.68" Height="18" Text="الخصم:" Font="Arial, 10pt, style=Bold" HorzAlign="Right" RightToLeft="true"/>
        <TextObject Name="v2" Left="0" Top="35" Width="110" Height="18" Text="[Invoice.DiscountValue]" Format="Number" Format.UseLocale="true" Font="Arial, 10pt, style=Bold" HorzAlign="Left"/>
        
        <LineObject Name="Line4" Left="20" Top="55" Width="239.68" Height="0" Border.Width="1"/>
        
        <TextObject Name="f3" Left="110" Top="60" Width="169.68" Height="22" Text="الصافي المطلوب:" Font="Arial, 12pt, style=Bold" HorzAlign="Right" RightToLeft="true"/>
        <TextObject Name="v3" Left="0" Top="60" Width="110" Height="22" Text="[Invoice.GrandTotal]" Format="Number" Format.UseLocale="true" Font="Arial, 14pt, style=Bold" HorzAlign="Left"/>
        
        <LineObject Name="Line5" Left="0" Top="88" Width="279.68" Height="0" Border.Width="1" Border.Style="Dash"/>
        <TextObject Name="lblPrintedBy" Left="0" Top="93" Width="279.68" Height="15" Text="الكاشير: [PrintedBy]" Font="Arial, 8pt" HorzAlign="Center" RightToLeft="true"/>
        <TextObject Name="lblThanks" Left="0" Top="110" Width="279.68" Height="15" Text="*** شكراً لزيارتكم ***" Font="Arial, 10pt, style=Bold" HorzAlign="Center" RightToLeft="true"/>
        
        <!-- Barcode for return scanner -->
        <BarcodeObject Name="BarcodeReturn" Left="14.84" Top="135" Width="250" Height="45" AutoSize="false" Text="[BarcodeText]" ShowText="true" Barcode="Code128" HorzAlign="Center"/>
      </GroupFooterBand>
    </GroupHeaderBand>
  </ReportPage>
</Report>
