      <TextObject Name="ValDebit"   Left="543.2" Width="90"    Height="20" Border.Lines="All" Border.Color="LightGray" Text="[Items.Debit]"         Format="Number" Format.UseLocale="false" Format.DecimalDigits="2" Format.DecimalSeparator="." Format.GroupSeparator="," Format.NegativePattern="1" HorzAlign="Center" VertAlign="Center" Font="Arial, 8pt" TextColor="Green"/>
