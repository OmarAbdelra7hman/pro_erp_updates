      <TextObject Name="txtReportTitle" Left="189" Top="100" Width="340.2" Height="28.35" Text="[ReportTitle]" HorzAlign="Center" VertAlign="Center" Font="Arial, 14pt, style=Bold" TextColor="DarkBlue"/>
      <!-- Account Info -->
      <TextObject Name="txtAccountLabel" Left="9.45" Top="132" Width="220" Height="18.9" Text="الحساب: [AccountName]" HorzAlign="Left" VertAlign="Center" Font="Arial, 10pt, style=Bold"/>
