                  Text="إلى: [DateTo]" HorzAlign="Right" VertAlign="Center"
                  Font="Arial, 9pt" TextColor="40,40,40"/>

      <!-- Opening Balance Card -->
      <ShapeObject Name="CardOpening" Left="0" Top="140" Width="200" Height="60" Border.Color="230,230,230" Border.Width="0.5" Fill.Color="248,249,252" Shape="RoundRectangle" Curve="4"/>
      <TextObject Name="lblOpening" Left="10" Top="144" Width="180" Height="16"
                  Text="الرصيد الافتتاحي" HorzAlign="Right" VertAlign="Center"
