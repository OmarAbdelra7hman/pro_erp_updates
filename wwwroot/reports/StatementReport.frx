      <TextObject Name="txtCurrency" Left="558.2" Top="132" Width="160" Height="18.9" Text="العملة: [Currency]" HorzAlign="Right" VertAlign="Center" Font="Arial, 9pt" TextColor="Gray"/>
      <!-- Date Range -->
      <TextObject Name="txtDateFrom" Left="9.45" Top="155" Width="350" Height="18.9" Text="الفترة من: [DateFrom]   إلى: [DateTo]" HorzAlign="Left" VertAlign="Center" Font="Arial, 9pt"/>
      <!-- Opening Balance -->
      <TextObject Name="txtOpeningBal" Left="434.7" Top="155" Width="283.5" Height="18.9" Text="الرصيد الافتتاحي: [OpeningBalance]" HorzAlign="Right" VertAlign="Center" Font="Arial, 9pt, style=Bold" TextColor="DarkBlue"/>
