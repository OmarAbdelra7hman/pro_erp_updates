  </Dictionary>
  <ReportPage Name="Page1" Watermark.Font="Arial, 60pt" PaperWidth="210" PaperHeight="297" LeftMargin="10" RightMargin="10" TopMargin="10" BottomMargin="10">

    <!-- ═══════════════════ REPORT TITLE BAND ═══════════════════ -->
    <ReportTitleBand Name="ReportTitle1" Width="718.2" Height="200">
      <!-- Logo on the LEFT -->
      <PictureObject Name="Logo" Left="623.7" Top="9.45" Width="85" Height="85" SizeMode="Zoom"/>
