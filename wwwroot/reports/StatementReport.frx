      <TextObject Name="txtSignLabel" Left="0" Top="60" Width="263.2" Height="18.9" Text="توقيع المسؤول: ________________" HorzAlign="Left" VertAlign="Bottom" Font="Arial, 8pt" TextColor="Gray"/>
