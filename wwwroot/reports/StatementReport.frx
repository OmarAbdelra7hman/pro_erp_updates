      <TextObject Name="txtOpeningBal" Left="10" Top="163" Width="180" Height="22"
                  Text="[OpeningBalance]" HorzAlign="Right" VertAlign="Center"
                  Font="Arial, 12pt, style=Bold" TextColor="30,64,130"/>
    </ReportTitleBand>

    <!-- ═══════════════════ PAGE HEADER (Column Titles) ═══════════════════ -->
    <PageHeaderBand Name="PageHeader1" Top="214" Width="703.08" Height="30" Fill.Color="30,64,130">
