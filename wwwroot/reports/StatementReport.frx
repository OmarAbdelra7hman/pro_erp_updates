<?xml version="1.0" encoding="utf-8"?>
<Report ReportInfo.Created="03/24/2026 12:30:00" ReportInfo.Modified="03/24/2026 19:20:00" ReportInfo.CreatorVersion="2026.1.8.0">
  <Dictionary>
    <BusinessObjectDataSource Name="Items" ReferenceName="Items" DataType="null" Enabled="true">
      <Column Name="Date" DataType="System.DateTime"/>
      <Column Name="OperationName" DataType="System.String"/>
      <Column Name="Reference" DataType="System.String"/>
      <Column Name="Description" DataType="System.String"/>
      <Column Name="Debit" DataType="System.Decimal"/>
      <Column Name="Credit" DataType="System.Decimal"/>
      <Column Name="Balance" DataType="System.Decimal"/>
    </BusinessObjectDataSource>
    <Parameter Name="CompanyName" DataType="System.String"/>
    <Parameter Name="TaxNumber" DataType="System.String"/>
    <Parameter Name="ReportTitle" DataType="System.String"/>
    <Parameter Name="ContactInfo" DataType="System.String"/>
