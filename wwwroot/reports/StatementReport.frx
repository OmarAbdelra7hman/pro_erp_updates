      <TextObject Name="ColDebit"   Left="533.08" Width="85"    Height="30" Text="مدين"       HorzAlign="Center" VertAlign="Center" Font="Arial, 8pt, style=Bold" TextColor="White"/>
      <TextObject Name="ColDate"    Left="618.08" Width="85"    Height="30" Text="التاريخ"    HorzAlign="Center" VertAlign="Center" Font="Arial, 8pt, style=Bold" TextColor="White"/>
    </PageHeaderBand>

    <!-- ═══════════════════ DATA BAND ═══════════════════ -->
    <DataBand Name="Data1" Top="248" Width="703.08" Height="22" DataSource="Items" EvenStyle="EvenRow">
      <TextObject Name="ValRef"     Left="0"     Width="70"     Height="22" Border.Lines="Bottom" Border.Color="240,240,240" Text="[Items.Reference]"     HorzAlign="Center" VertAlign="Center" Font="Arial, 7.5pt" TextColor="80,80,80"/>
      <TextObject Name="ValDesc"    Left="70"    Width="183.08" Height="22" Border.Lines="Bottom" Border.Color="240,240,240" Text="[Items.Description]"   HorzAlign="Right"  VertAlign="Center" Font="Arial, 7.5pt" TextColor="80,80,80" Padding="0, 0, 6, 0"/>
      <TextObject Name="ValType"    Left="253.08" Width="100"   Height="22" Border.Lines="Bottom" Border.Color="240,240,240" Text="[Items.OperationName]" HorzAlign="Center" VertAlign="Center" Font="Arial, 7.5pt" TextColor="60,60,60"/>
      <TextObject Name="ValBalance" Left="353.08" Width="95"    Height="22" Border.Lines="Bottom" Border.Color="240,240,240" Text="[Items.Balance]"       Format="Number" Format.UseLocale="false" Format.DecimalDigits="2" Format.DecimalSeparator="." Format.GroupSeparator="," Format.NegativePattern="1" HorzAlign="Center" VertAlign="Center" Font="Arial, 8pt, style=Bold" TextColor="30,64,130"/>
      <TextObject Name="ValCredit"  Left="448.08" Width="85"    Height="22" Border.Lines="Bottom" Border.Color="240,240,240" Text="[Items.Credit]"        Format="Number" Format.UseLocale="false" Format.DecimalDigits="2" Format.DecimalSeparator="." Format.GroupSeparator="," Format.NegativePattern="1" HorzAlign="Center" VertAlign="Center" Font="Arial, 7.5pt" TextColor="198,40,40"/>
      <TextObject Name="ValDebit"   Left="533.08" Width="85"    Height="22" Border.Lines="Bottom" Border.Color="240,240,240" Text="[Items.Debit]"         Format="Number" Format.UseLocale="false" Format.DecimalDigits="2" Format.DecimalSeparator="." Format.GroupSeparator="," Format.NegativePattern="1" HorzAlign="Center" VertAlign="Center" Font="Arial, 7.5pt" TextColor="46,125,50"/>
      <TextObject Name="ValDate"    Left="618.08" Width="85"    Height="22" Border.Lines="Bottom" Border.Color="240,240,240" Text="[Items.Date]"          Format="Date" Format.Format="yyyy-MM-dd" HorzAlign="Center" VertAlign="Center" Font="Arial, 7.5pt" TextColor="80,80,80"/>
    </DataBand>

