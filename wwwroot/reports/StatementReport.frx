      <TextObject Name="txtCompanyName" Left="9.45" Top="9.45" Width="330.75" Height="28.35" Text="[CompanyName]" HorzAlign="Left" VertAlign="Center" Font="Arial, 14pt, style=Bold" TextColor="DarkBlue"/>
      <!-- Tax Number -->
      <TextObject Name="txtTax" Left="9.45" Top="37.8" Width="330.75" Height="18.9" Text="الرقم الضريبي: [TaxNumber]" HorzAlign="Left" VertAlign="Center" Font="Arial, 9pt" TextColor="Gray"/>
      <!-- Contact Info -->
      <TextObject Name="txtContact" Left="9.45" Top="56.7" Width="330.75" Height="28.35" Text="[ContactInfo]" HorzAlign="Left" VertAlign="Center" Font="Arial, 8pt" TextColor="Gray"/>
