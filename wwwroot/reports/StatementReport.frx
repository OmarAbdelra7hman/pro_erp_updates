<?xml version="1.0" encoding="utf-8"?>
<Report ReportInfo.Created="03/24/2026 12:30:00" ReportInfo.Modified="05/12/2026 19:00:00" ReportInfo.CreatorVersion="2026.1.8.0">
  <Dictionary>
    <BusinessObjectDataSource Name="Items" ReferenceName="Items" DataType="null" Enabled="true">
      <Column Name="Date" DataType="System.DateTime"/>
      <Column Name="OperationName" DataType="System.String"/>
      <Column Name="Reference" DataType="System.String"/>
      <Column Name="Description" DataType="System.String"/>
      <Column Name="Debit" DataType="System.Decimal"/>
      <Column Name="Credit" DataType="System.Decimal"/>
      <Column Name="Balance" DataType="System.Decimal"/>
    </BusinessObjectDataSource>
    <Parameter Name="CompanyName" DataType="System.String"/>
    <Parameter Name="TaxNumber" DataType="System.String"/>
    <Parameter Name="ReportTitle" DataType="System.String"/>
    <Parameter Name="ContactInfo" DataType="System.String"/>
    <Parameter Name="AccountName" DataType="System.String"/>
    <Parameter Name="AccountCode" DataType="System.String"/>
    <Parameter Name="DateFrom" DataType="System.String"/>
    <Parameter Name="DateTo" DataType="System.String"/>
    <Parameter Name="TotalDebit" DataType="System.String"/>
    <Parameter Name="TotalCredit" DataType="System.String"/>
    <Parameter Name="OpeningBalance" DataType="System.String"/>
    <Parameter Name="ClosingBalance" DataType="System.String"/>
    <Parameter Name="Currency" DataType="System.String"/>
    <Parameter Name="PrintedBy" DataType="System.String"/>
  </Dictionary>
  <ReportPage Name="Page1" Watermark.Font="Arial, 60pt" PaperWidth="210" PaperHeight="297" LeftMargin="12" RightMargin="12" TopMargin="12" BottomMargin="12">

    <!-- ═══════════════════ REPORT TITLE BAND ═══════════════════ -->
    <ReportTitleBand Name="ReportTitle1" Width="703.08" Height="210">
      <!-- Accent Top Bar -->
      <ShapeObject Name="AccentBar" Width="703.08" Height="5" Fill.Color="30,64,130"/>

      <!-- Logo -->
      <PictureObject Name="Logo" Left="608" Top="14" Width="85" Height="85" SizeMode="Zoom"/>

      <!-- Company Name -->
      <TextObject Name="txtCompanyName" Left="9.45" Top="14" Width="400" Height="30"
                  Text="[CompanyName]" HorzAlign="Left" VertAlign="Center"
                  Font="Arial, 16pt, style=Bold" TextColor="30,64,130"/>

      <!-- Tax Number -->
      <TextObject Name="txtTax" Left="9.45" Top="44" Width="400" Height="18"
                  Text="الرقم الضريبي: [TaxNumber]" HorzAlign="Left" VertAlign="Center"
                  Font="Arial, 8pt" TextColor="130,130,130"/>

      <!-- Contact Info -->
      <TextObject Name="txtContact" Left="9.45" Top="60" Width="400" Height="22"
                  Text="[ContactInfo]" HorzAlign="Left" VertAlign="Center"
                  Font="Arial, 8pt" TextColor="130,130,130"/>

      <!-- Separator -->
      <LineObject Name="Line1" Left="0" Top="100" Width="703.08" Border.Color="220,220,220" Border.Width="0.75"/>

      <!-- Report Title -->
      <TextObject Name="txtReportTitle" Left="170" Top="106" Width="363.08" Height="28"
                  Text="[ReportTitle]" HorzAlign="Center" VertAlign="Center"
                  Font="Arial, 14pt, style=Bold" TextColor="30,64,130"/>

      <!-- Info Cards Row -->
      <!-- Account Card -->
      <ShapeObject Name="CardAccount" Left="420" Top="140" Width="283.08" Height="60" Border.Color="230,230,230" Border.Width="0.5" Fill.Color="248,249,252" Shape="RoundRectangle" Curve="4"/>
      <TextObject Name="lblAccount" Left="430" Top="144" Width="265" Height="16"
                  Text="الحساب" HorzAlign="Right" VertAlign="Center"
                  Font="Arial, 7pt" TextColor="130,130,130"/>
      <TextObject Name="txtAccountName" Left="430" Top="160" Width="265" Height="18"
                  Text="[AccountName]" HorzAlign="Right" VertAlign="Center"
                  Font="Arial, 10pt, style=Bold" TextColor="40,40,40"/>
      <TextObject Name="txtAccountCode" Left="430" Top="178" Width="265" Height="14"
                  Text="كود: [AccountCode]  |  العملة: [Currency]" HorzAlign="Right" VertAlign="Center"
                  Font="Arial, 7pt" TextColor="130,130,130"/>

      <!-- Period Card -->
      <ShapeObject Name="CardPeriod" Left="210" Top="140" Width="200" Height="60" Border.Color="230,230,230" Border.Width="0.5" Fill.Color="248,249,252" Shape="RoundRectangle" Curve="4"/>
      <TextObject Name="lblPeriod" Left="220" Top="144" Width="180" Height="16"
                  Text="الفترة" HorzAlign="Right" VertAlign="Center"
